{
  "name": "plume",
  "private": true,
  "version": "0.1.0",
  "description": "A clean, lightweight PostgreSQL desktop workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byteweap/plume.git"
  },
  "bugs": {
    "url": "https://github.com/byteweap/plume/issues"
  },
  "homepage": "https://github.com/byteweap/plume#readme",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "benchmark:bundle": "npm run build && node scripts/benchmark-production-bundle.mjs",
    "benchmark:core": "node --expose-gc ./node_modules/vitest/vitest.mjs run src/performance/corePerformance.test.tsx --reporter=verbose",
    "benchmark:grid": "node --expose-gc scripts/benchmark-data-grid.mjs",
    "benchmark:editor": "node --expose-gc scripts/benchmark-sql-editor.mjs",
    "benchmark:regression": "npm run benchmark:core && npm run benchmark:editor && npm run benchmark:grid && npm run benchmark:bundle",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:unit-baseline && npm run test:acceptance",
    "check:all": "npm run check:security && npm run check:docs && npm run check:i18n && npm run check:release:macos && npm run check:release:windows && npm run check && npm run build && npm run check:rust",
    "check:docs": "node scripts/check-open-source.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:release:macos": "node scripts/check-macos-release.mjs --config-only",
    "check:release:windows": "node scripts/check-windows-release.mjs --config-only",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check:security": "node scripts/check-security.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "postgres:down": "docker compose -f compose.postgres.yml down --volumes",
    "postgres:certificates": "node scripts/generate-postgres-tls.mjs",
    "postgres:ssh-fixtures": "node scripts/generate-ssh-fixtures.mjs",
    "postgres:up": "npm run postgres:certificates && npm run postgres:ssh-fixtures && docker compose -f compose.postgres.yml up --detach --wait --build --force-recreate --renew-anon-volumes",
    "test:postgres": "node scripts/test-postgres.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:acceptance": "vitest run src/features/connections/ConnectionDialog.test.tsx src/features/database-tree/ConnectionTreeItem.test.tsx src/app/App.test.tsx src/features/query-results/ResultExportDialog.test.tsx src/features/sql-editor/SqlEditor.test.tsx -t \"AC-\"",
    "test:unit-baseline": "vitest run src/features/connections/connectionUrl.test.ts src/features/table-data/tableData.test.ts src/features/sql-editor/sqlExecutionTarget.test.ts src/features/sql-safety/sqlRiskAnalysis.test.ts src/features/query-results/queryResultValue.test.ts src/features/table-data/tableDataChanges.test.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:release:macos": "node scripts/check-macos-release.mjs",
    "verify:release:windows": "node scripts/check-windows-release.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@tauri-apps/api": "^2",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.27.0",
    "react": "^19.1.0",
    "react-data-grid": "7.0.0-beta.57",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
